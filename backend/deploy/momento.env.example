# SQLite database file (WAL mode). One process per database.
MOMENTO_DB=/var/lib/momento/momento.db
# First-boot operator password for operator@momento.local (change it after login)
SETUP_PASSWORD=change-me-now
# Comma-separated CORS allow-list; unset or * = any origin
CORS_ORIGINS=https://your-frontend.example
# Signed ingest (S-1): when set, POST /api/v1/ingest needs X-Momento-Ts / -Nonce / -Signature
INGEST_HMAC_SECRET=
# Optional AI summaries (v6.4 deep tier)
ENTRIM_API_KEY=
# Scheduler: alarm/calibration tick (seconds), intel rounds drained per tick, intel rounds scored inside an ingest request
MOMENTO_TICK_SECONDS=10
MOMENTO_INTEL_DRAIN=40
MOMENTO_INGEST_INTEL_BUDGET=10
# Set to 0 to disable the background scheduler (tests)
MOMENTO_SCHEDULER=1
